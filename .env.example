# ==========================================
# CertiFlow Environment Configuration Template
# ==========================================

# PostgreSQL Configuration
POSTGRES_USER=certiflow
POSTGRES_PASSWORD=certiflow_secret
POSTGRES_DB=certiflow_db
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PORT=6379

# Backend API Configuration
PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://certiflow:certiflow_secret@postgres:5432/certiflow_db?schema=public
REDIS_URL=redis://redis:6379

# Frontend Configuration
VITE_API_URL=http://localhost:5000

# Verification & Certificate Configuration
VERIFICATION_BASE_URL=http://localhost:5173/verify
